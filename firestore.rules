rules_version = '2';

// Burkan Taekwondo Portal: Firestore security rules.
//
// Paste this whole file into Firebase console -> Firestore -> Rules -> Publish
// (or deploy with `firebase deploy --only firestore:rules`).
//
// The browser talks to Firestore directly, so these rules ARE the security.
// Anything not explicitly allowed below is denied.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isApproved() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && myProfile().status == 'approved';
    }

    function isAdmin() {
      return isApproved() && myProfile().role == 'admin';
    }

    // One document per person, keyed by their Firebase Auth uid.
    match /users/{uid} {
      // You can read your own profile; admins can read everyone's.
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());

      // Sign-up: you may create ONLY your own profile, ONLY as a pending
      // request, with no role. Nobody can sign up straight into access.
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(
             ['email', 'displayName', 'requestedRole', 'role', 'status', 'createdAt'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 100
        && request.resource.data.requestedRole in ['parent', 'student', 'coach']
        && request.resource.data.role == null
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;

      // Approve / decline / change role: admins only, and only these fields.
      // An admin can't remove their own admin access, so the club can't be
      // locked out by accident.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'role', 'reviewedBy', 'reviewedAt'])
        && request.resource.data.status in ['pending', 'approved', 'rejected']
        && (request.resource.data.role == null
            || request.resource.data.role in ['parent', 'student', 'coach', 'admin'])
        && (request.resource.data.status != 'approved' || request.resource.data.role != null)
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.reviewedAt == request.time
        && (uid != request.auth.uid
            || (request.resource.data.status == 'approved'
                && request.resource.data.role == 'admin'));

      allow delete: if false;
    }

    // Everything else stays locked until its rules are written.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
